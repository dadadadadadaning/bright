# Copy to a private file on your server if desired, then:
#   CMR_V1_ENV=/path/to/cmr_v1_paths.env bash run/run_CMR_V1_isolated.sh audit_complement

SEED=3407
GPU_ID=0

# Project-local dataset directory by default. Override when your data live elsewhere.
DATASET_ROOT=/root/shared-nvme/BRIGHT-master/dataset

# Frozen P3 checkpoint used when CMR-P0 / M3 caches were built.
P3_CKPT=/root/shared-nvme/BRIGHT-checkpoints/S8_MICB_DSMIL/BRIGHT/S8_P3_DSMIL_EBS16/best_val_miou.pth

# Existing read-only upstream caches. V1 never overwrites them.
P0_ROOT=/root/shared-nvme/BRIGHT-eval-results/CMR_POOLING
M3_ROOT=/root/shared-nvme/BRIGHT-eval-results/CMR_M3_PAIRWISE

# V1 writes only here.
RESULT_ROOT=/root/shared-nvme/BRIGHT-eval-results/CMR_V1_ISOLATED

# Region identity safety: unresolved rows are quarantined, never guessed.
WARN_VERIFIED_FRACTION=0.02
MAX_VERIFIED_FRACTION=0.05
MAX_UNRESOLVED_FRACTION=0.005

# Avoid global max-token padding in large query caches.
TOKEN_STORAGE_LAYOUT=packed_list
